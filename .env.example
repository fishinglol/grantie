# Used by netlify/functions/send-welcome-email.js
# Get a key at https://resend.com — the default sender (onboarding@resend.dev) works
# without any setup; verify your own domain there later to send from your own address.
RESEND_API_KEY=

# Used by the frontend (src/components/Signup.tsx) — from your Supabase project →
# Settings → API, after running supabase/schema.sql. The anon key is meant to be
# public — access is limited by the RLS policy in that file (insert-only, no read).
# Vite only exposes VITE_-prefixed vars to client code, so these need the prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For local testing only (netlify dev). In production these aren't read from here —
# set them in the Netlify dashboard instead: Site settings → Environment variables.
