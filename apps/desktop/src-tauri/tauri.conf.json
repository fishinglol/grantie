{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Granite",
  "version": "0.1.5",
  "identifier": "dev.granite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Granite",
        "width": 1000,
        "height": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRDZENTYwRjA1NkFDNzMKUldSenJGYndZTlhXODhVdTVrZitzV0NOdisreFpQNE96RUM0RlBad3l4N2NVeS94M3F0Zis1QmsK",
      "endpoints": [
        "https://github.com/fishinglol/grantie/releases/latest/download/latest.json"
      ]
    }
  }
}
