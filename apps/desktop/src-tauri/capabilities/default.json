{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$APPCONFIG/**" }, { "path": "$HOME/**/.granite" }, { "path": "$HOME/**/.granite/**" }, { "path": "$DOCUMENT/**/.granite" }, { "path": "$DOCUMENT/**/.granite/**" } ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://oauth2.googleapis.com/*" },
        { "url": "https://www.googleapis.com/*" }
      ]
    }
  ]
}
